{"task_id": 2, "source": "mbpp-sanitized", "split": "prompt", "requirement": "Write a function to find the shared elements from the given two lists.", "function_name": "similar_elements", "function_signature": "def similar_elements(test_tup1, test_tup2)", "target_code": "def similar_elements(test_tup1, test_tup2):\n  res = tuple(set(test_tup1) & set(test_tup2))\n  return (res) ", "feedback_tests": ["assert set(similar_elements((3, 4, 5, 6),(5, 7, 4, 10))) == set((4, 5))", "assert set(similar_elements((1, 2, 3, 4),(5, 4, 3, 7))) == set((3, 4))", "assert set(similar_elements((11, 12, 14, 13),(17, 15, 14, 13))) == set((13, 14))"], "hidden_tests": [], "test_imports": [], "reference_test_results": [{"test": "assert set(similar_elements((3, 4, 5, 6),(5, 7, 4, 10))) == set((4, 5))", "passed": true, "error": null}, {"test": "assert set(similar_elements((1, 2, 3, 4),(5, 4, 3, 7))) == set((3, 4))", "passed": true, "error": null}, {"test": "assert set(similar_elements((11, 12, 14, 13),(17, 15, 14, 13))) == set((13, 14))", "passed": true, "error": null}]}
{"task_id": 12, "source": "mbpp-sanitized", "split": "test", "requirement": "Write a function to sort a given matrix in ascending order according to the sum of its rows.", "function_name": "sort_matrix", "function_signature": "def sort_matrix(M)", "target_code": "def sort_matrix(M):\n    result = sorted(M, key=sum)\n    return result", "feedback_tests": ["assert sort_matrix([[1, 2, 3], [2, 4, 5], [1, 1, 1]])==[[1, 1, 1], [1, 2, 3], [2, 4, 5]]", "assert sort_matrix([[1, 2, 3], [-2, 4, -5], [1, -1, 1]])==[[-2, 4, -5], [1, -1, 1], [1, 2, 3]]", "assert sort_matrix([[5,8,9],[6,4,3],[2,1,4]])==[[2, 1, 4], [6, 4, 3], [5, 8, 9]]"], "hidden_tests": [], "test_imports": [], "reference_test_results": [{"test": "assert sort_matrix([[1, 2, 3], [2, 4, 5], [1, 1, 1]])==[[1, 1, 1], [1, 2, 3], [2, 4, 5]]", "passed": true, "error": null}, {"test": "assert sort_matrix([[1, 2, 3], [-2, 4, -5], [1, -1, 1]])==[[-2, 4, -5], [1, -1, 1], [1, 2, 3]]", "passed": true, "error": null}, {"test": "assert sort_matrix([[5,8,9],[6,4,3],[2,1,4]])==[[2, 1, 4], [6, 4, 3], [5, 8, 9]]", "passed": true, "error": null}]}
{"task_id": 555, "source": "mbpp-sanitized", "split": "validation", "requirement": "Write a python function to find the difference between the sum of cubes of the first n natural numbers and the sum of the first n natural numbers.", "function_name": "difference", "function_signature": "def difference(n)", "target_code": "def difference(n) :  \n    S = (n*(n + 1))//2;  \n    res = S*(S-1);  \n    return res;  ", "feedback_tests": ["assert difference(3) == 30", "assert difference(5) == 210", "assert difference(2) == 6"], "hidden_tests": [], "test_imports": [], "reference_test_results": [{"test": "assert difference(3) == 30", "passed": true, "error": null}, {"test": "assert difference(5) == 210", "passed": true, "error": null}, {"test": "assert difference(2) == 6", "passed": true, "error": null}]}
{"task_id": 604, "source": "mbpp-sanitized", "split": "train", "requirement": "Write a function to reverse words seperated by spaces in a given string.", "function_name": "reverse_words", "function_signature": "def reverse_words(s)", "target_code": "def reverse_words(s):\n        return ' '.join(reversed(s.split()))", "feedback_tests": ["assert reverse_words(\"python program\")==(\"program python\")", "assert reverse_words(\"java language\")==(\"language java\")", "assert reverse_words(\"indian man\")==(\"man indian\")"], "hidden_tests": [], "test_imports": [], "reference_test_results": [{"test": "assert reverse_words(\"python program\")==(\"program python\")", "passed": true, "error": null}, {"test": "assert reverse_words(\"java language\")==(\"language java\")", "passed": true, "error": null}, {"test": "assert reverse_words(\"indian man\")==(\"man indian\")", "passed": true, "error": null}]}
